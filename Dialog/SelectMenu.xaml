<Window x:Class="CoreLib.SelectMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoreLib"
        mc:Ignorable="d"
        Title="SelectMenu" Height="65" Width="300" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Grid>
        <ComboBox Name="CbMenu" SelectionChanged="CbMenu_SelectionChanged" MouseDoubleClick="CbMenu_MouseDoubleClick" />
    </Grid>
</Window>
