<Window x:Class="CoreLib.FileDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoreLib"
        mc:Ignorable="d"
        Title="ファイル削除" Height="220" Width="450" Loaded="Window_Loaded">
    <Grid>
        <TextBlock Text="ファイル名" Height="18" Margin="5,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Name="tbFileName" Height="18" Margin="60,5,5,0" VerticalAlignment="Top" />
        <TextBlock Text="フォルダ" Height="18" Margin="5,25,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Name="tbSrcFolder" Height="18" Margin="60,25,5,0" VerticalAlignment="Top" />
        <TextBlock Text="日付" Height="18" Margin="20,45,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Name="tbSrcDateTime" Width="110" Height="18" Margin="60,45,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="サイズ" Height="18" Margin="180,45,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Name="tbSrcSize" Width="100" Height="18" Margin="220,45,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Name="tbProgress"  Text="進捗" Height="18" Margin="20,65,10,0" VerticalAlignment="Top" />
        <ProgressBar Name="pbCopyCount" Height="10" Margin="100,70,20,0" VerticalAlignment="Top"/>
        <StackPanel Orientation="Vertical" Margin="0,90,0,0" >
            <StackPanel Name="spFileSelect" Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="対象ファイル" FontSize="11" Margin="0,0,5,0"/>
                <TextBox Name="tbTargetFile" Width="70"/>
                <TextBlock Text="除外ファイル" FontSize="11" Margin="5,0,5,0"/>
                <TextBox Name="tbExceptFile" Width="70"/>
                <TextBlock Text="除外ディレクトリ" FontSize="11" Margin="5,0,0,0"/>
                <TextBox Name="tbExceptDirectory" Width="70"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center" >
                <CheckBox Name="cbCheckedMessage" Content="確認メッセージを出す" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Height="20" HorizontalAlignment="Center" >
                <Button Name="btOK" Content="はい" Width="60" Click="btOK_Click"/>
                <Button Name="btNO" Content="いいえ" Width="60" Margin="10,0,10,0" Click="btNO_Click"/>
                <Button Name="btCancel" Content="キャンセル" Width="60" Click="btCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
