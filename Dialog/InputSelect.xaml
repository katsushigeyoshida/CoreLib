<Window x:Class="CoreLib.InputSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoreLib"
        mc:Ignorable="d"
        Title="InputSelect" Height="90" Width="300" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <ComboBox Name="cbText" Margin="10,10,10,0" IsEditable="True" VerticalAlignment="Top" MouseDoubleClick="cbText_MouseDoubleClick" />
        <CheckBox x:Name="cbCheck" Margin="10,40,0,0" Content="CheckBox" HorizontalAlignment="Left" VerticalAlignment="Top"  />
        <Button Name="btOK" Content="OK" Margin="0,0,60,10" Width="50" IsDefault="True" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="btOK_Click" />
        <Button Name="btCancel" Content="Cancel" Margin="0,0,10,10" Width="50" IsCancel="True" VerticalAlignment="Bottom" HorizontalAlignment="Right" Click="btCancel_Click" />
    </Grid>
</Window>
